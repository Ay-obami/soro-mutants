+//! Behavior when the project path is a symlink: project-relative reporting is
+//! unchanged, cleanup stays inside the real project, and failures are
+//! structured. Symlink creation needs Unix permissions, so this file is
+//! Unix-only.
+#![cfg(unix)]
+
+use std::{
+    fs,
+    os::unix::fs::symlink,
+    path::{Path, PathBuf},
+    process::{Command, Output},
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+struct TempDir(PathBuf);
+
+impl TempDir {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "soro-mutants-symlink-root-{}-{}",
+            std::process::id(),
+            SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir_all(&path).unwrap();
+        Self(path.canonicalize().unwrap())
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn cli(args: &[&str], path: &Path, extra: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_cargo-soro-mutants"))
+        .args(args)
+        .arg(path)
+        .args(extra)
+        .output()
+        .expect("CLI should run")
+}
+
+fn fixture() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("fixtures/weak-auth")
+}
+
+fn stderr(output: &Output) -> String {
+    String::from_utf8_lossy(&output.stderr).into_owned()
+}
+
+#[test]
+fn list_output_is_identical_through_a_symlink() {
+    let tmp = TempDir::new();
+    let link = tmp.0.join("project-link");
+    symlink(fixture(), &link).unwrap();
+
+    let direct = cli(&["list"], &fixture(), &["--json"]);
+    let linked = cli(&["list"], &link, &["--json"]);
+    assert!(direct.status.success(), "{}", stderr(&direct));
+    assert!(linked.status.success(), "{}", stderr(&linked));
+    assert_eq!(direct.stdout, linked.stdout);
+
+    let json = String::from_utf8(linked.stdout).unwrap();
+    assert!(!json.contains("project-link"), "{json}");
+    assert!(json.contains("src/lib.rs"), "{json}");
+}
+
+#[test]
+fn symlink_use_is_reported_as_a_note_only_when_it_happens() {
+    let tmp = TempDir::new();
+    let link = tmp.0.join("project-link");
+    symlink(fixture(), &link).unwrap();
+
+    let linked = cli(&["list"], &link, &["--count-only"]);
+    let text = stderr(&linked);
+    assert!(text.starts_with("note: project path "), "{text}");
+    assert!(text.contains("is a symlink; using resolved root"), "{text}");
+    assert!(text.contains(&link.display().to_string()), "{text}");
+
+    let direct = cli(&["list"], &fixture(), &["--count-only"]);
+    assert_eq!(stderr(&direct), "");
+}
+
+#[test]
+fn clean_through_a_symlink_removes_only_managed_state_in_the_real_project() {
+    let tmp = TempDir::new();
+    let real = tmp.0.join("real");
+    let link = tmp.0.join("link");
+    fs::create_dir_all(real.join(".soro-mutants-target/baseline")).unwrap();
+    fs::create_dir_all(real.join(".soro-mutants-worktree")).unwrap();
+    fs::write(real.join("keep.txt"), "user data").unwrap();
+    symlink(&real, &link).unwrap();
+
+    let dry = cli(&["clean"], &link, &["--dry-run"]);
+    assert!(dry.status.success(), "{}", stderr(&dry));
+    let listed = String::from_utf8(dry.stdout).unwrap();
+    assert!(listed.contains("Would remove"), "{listed}");
+    assert!(
+        listed.contains(&real.display().to_string()),
+        "paths should be under the real root: {listed}"
+    );
+    assert!(real.join(".soro-mutants-worktree").exists());
+
+    let output = cli(&["clean"], &link, &[]);
+    assert!(output.status.success(), "{}", stderr(&output));
+    assert!(!real.join(".soro-mutants-target").exists());
+    assert!(!real.join(".soro-mutants-worktree").exists());
+    assert_eq!(fs::read_to_string(real.join("keep.txt")).unwrap(), "user data");
+    assert!(
+        fs::symlink_metadata(&link).unwrap().file_type().is_symlink(),
+        "the project symlink itself must survive cleanup"
+    );
+}
+
+#[test]
+fn clean_refuses_a_managed_path_that_is_a_symlink_out_of_the_project() {
+    let tmp = TempDir::new();
+    let real = tmp.0.join("real");
+    let outside = tmp.0.join("outside");
+    let link = tmp.0.join("link");
+    fs::create_dir_all(&real).unwrap();
+    fs::create_dir_all(&outside).unwrap();
+    fs::write(outside.join("precious.txt"), "keep").unwrap();
+    symlink(&outside, real.join(".soro-mutants-target")).unwrap();
+    symlink(&real, &link).unwrap();
+
+    let output = cli(&["clean"], &link, &[]);
+    assert_eq!(output.status.code(), Some(1));
+    assert!(
+        stderr(&output).contains("refusing to clean symlinked Soro Mutants path"),
+        "{}",
+        stderr(&output)
+    );
+    assert_eq!(
+        fs::read_to_string(outside.join("precious.txt")).unwrap(),
+        "keep"
+    );
+}
+
+#[test]
+fn dangling_symlink_is_a_structured_error() {
+    let tmp = TempDir::new();
+    let link = tmp.0.join("dangling");
+    let target = tmp.0.join("gone");
+    symlink(&target, &link).unwrap();
+
+    for command in ["list", "test", "clean"] {
+        let output = cli(&[command], &link, &[]);
+        assert_eq!(output.status.code(), Some(1), "{command}");
+        let text = stderr(&output);
+        assert!(text.starts_with("error: cannot resolve "), "{text}");
+        assert!(text.contains("symlink points to"), "{text}");
+        assert!(text.contains(&target.display().to_string()), "{text}");
+        assert!(!text.contains("panicked"), "{text}");
+    }
+}
+
+#[test]
+fn symlink_cycle_is_a_structured_error() {
+    let tmp = TempDir::new();
+    let a = tmp.0.join("a");
+    let b = tmp.0.join("b");
+    symlink(&b, &a).unwrap();
+    symlink(&a, &b).unwrap();
+
+    let output = cli(&["list"], &a, &[]);
+    assert_eq!(output.status.code(), Some(1));
+    let text = stderr(&output);
+    assert!(text.starts_with("error: cannot resolve "), "{text}");
+    assert!(text.contains("symlink cycle"), "{text}");
+    assert!(!text.contains("panicked"), "{text}");
+}
