@@ -0,0 +1,284 @@
+//! Resolution of the project path given on the command line.
+//!
+//! `list`, `test`, and `clean` all treat the project path as a starting point
+//! and immediately resolve it to a canonical directory. Everything after that
+//! point (discovery, project-relative report paths, scratch worktrees, cache
+//! directories, and cleanup) uses the resolved root, so the result is the same
+//! whether the tool is invoked through a symlink or through the real directory.
+//!
+//! This module centralizes that step so the behavior is defined and tested in
+//! one place, failures are structured and actionable, and the use of a symlink
+//! is observable through a `note:` diagnostic.
+
+use std::{
+    error::Error,
+    fmt, fs, io,
+    path::{Path, PathBuf},
+};
+
+use crate::diagnostics;
+
+/// A project path that has been resolved to a canonical directory.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProjectRoot {
+    /// The path exactly as the user supplied it.
+    pub requested: PathBuf,
+    /// Canonical root used for discovery, reporting, caches, and cleanup.
+    pub resolved: PathBuf,
+    /// Whether the requested path itself is a symbolic link.
+    pub symlinked: bool,
+}
+
+impl ProjectRoot {
+    /// Human-readable description of the symlink resolution, if one happened.
+    ///
+    /// Returns `None` when the requested path is not itself a symlink, so
+    /// existing invocations produce no new output.
+    pub fn symlink_note(&self) -> Option<String> {
+        self.symlinked.then(|| {
+            format!(
+                "project path {} is a symlink; using resolved root {} for discovery, reports, and cleanup",
+                self.requested.display(),
+                self.resolved.display()
+            )
+        })
+    }
+
+    /// Emits the symlink note on stderr. Reports on stdout are unaffected.
+    pub fn announce(&self) {
+        if let Some(note) = self.symlink_note() {
+            diagnostics::note(&note);
+        }
+    }
+}
+
+/// Why a project path could not be resolved.
+///
+/// Every message starts with `cannot resolve <path>` so the long-standing
+/// diagnostic prefix is unchanged for scripts that match on it.
+#[derive(Debug)]
+pub enum ProjectRootError {
+    /// The path is a symlink whose target does not exist.
+    DanglingSymlink { path: PathBuf, target: PathBuf },
+    /// The path is, or passes through, a cycle of symbolic links.
+    SymlinkLoop { path: PathBuf },
+    /// Any other failure; the underlying I/O error is the error's source.
+    Io { path: PathBuf, source: io::Error },
+}
+
+impl fmt::Display for ProjectRootError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::DanglingSymlink { path, target } => write!(
+                f,
+                "cannot resolve {}: symlink points to {}, which does not exist; \
+                 fix or recreate the link, or pass the real project directory",
+                path.display(),
+                target.display()
+            ),
+            Self::SymlinkLoop { path } => write!(
+                f,
+                "cannot resolve {}: too many levels of symbolic links; \
+                 the project path is part of a symlink cycle",
+                path.display()
+            ),
+            Self::Io { path, .. } => write!(f, "cannot resolve {}", path.display()),
+        }
+    }
+}
+
+impl Error for ProjectRootError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Io { source, .. } => Some(source),
+            _ => None,
+        }
+    }
+}
+
+/// Resolves `requested` to a canonical project root.
+pub fn resolve(requested: &Path) -> Result<ProjectRoot, ProjectRootError> {
+    match requested.canonicalize() {
+        Ok(resolved) => Ok(ProjectRoot {
+            requested: requested.to_path_buf(),
+            resolved,
+            symlinked: is_symlink(requested),
+        }),
+        Err(error) => Err(classify(requested, error)),
+    }
+}
+
+/// `true` when the final component of `path` is a symbolic link.
+///
+/// Trailing separators and `.` components are dropped first, because a
+/// trailing slash would otherwise make the OS follow the link.
+fn is_symlink(path: &Path) -> bool {
+    let normalized: PathBuf = path.components().collect();
+    fs::symlink_metadata(normalized)
+        .map(|metadata| metadata.file_type().is_symlink())
+        .unwrap_or(false)
+}
+
+fn classify(path: &Path, error: io::Error) -> ProjectRootError {
+    if is_symlink_loop(&error) {
+        return ProjectRootError::SymlinkLoop {
+            path: path.to_path_buf(),
+        };
+    }
+    if error.kind() == io::ErrorKind::NotFound && is_symlink(path) {
+        let normalized: PathBuf = path.components().collect();
+        let target = fs::read_link(normalized).unwrap_or_default();
+        return ProjectRootError::DanglingSymlink {
+            path: path.to_path_buf(),
+            target,
+        };
+    }
+    ProjectRootError::Io {
+        path: path.to_path_buf(),
+        source: error,
+    }
+}
+
+/// Recognizes the OS error for "too many levels of symbolic links".
+fn is_symlink_loop(error: &io::Error) -> bool {
+    let Some(code) = error.raw_os_error() else {
+        return false;
+    };
+    (cfg!(any(target_os = "linux", target_os = "android")) && code == 40)
+        || (cfg!(any(
+            target_os = "macos",
+            target_os = "ios",
+            target_os = "freebsd",
+            target_os = "openbsd",
+            target_os = "netbsd",
+            target_os = "dragonfly"
+        )) && code == 62)
+        || (cfg!(windows) && code == 1921)
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::{
+        os::unix::fs::symlink,
+        sync::atomic::{AtomicU64, Ordering},
+    };
+
+    static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "soro-mutants-projectroot-{}-{}",
+                std::process::id(),
+                SEQUENCE.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir_all(&path).unwrap();
+            Self(path.canonicalize().unwrap())
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn plain_directory_is_not_reported_as_symlink() {
+        let tmp = TempDir::new();
+        let real = tmp.0.join("real");
+        fs::create_dir(&real).unwrap();
+
+        let root = resolve(&real).unwrap();
+        assert_eq!(root.resolved, real);
+        assert!(!root.symlinked);
+        assert!(root.symlink_note().is_none());
+    }
+
+    #[test]
+    fn symlinked_root_resolves_to_real_directory() {
+        let tmp = TempDir::new();
+        let real = tmp.0.join("real");
+        let link = tmp.0.join("link");
+        fs::create_dir(&real).unwrap();
+        symlink(&real, &link).unwrap();
+
+        let root = resolve(&link).unwrap();
+        assert_eq!(root.requested, link);
+        assert_eq!(root.resolved, real);
+        assert!(root.symlinked);
+        let note = root.symlink_note().unwrap();
+        assert!(note.contains(&link.display().to_string()));
+        assert!(note.contains(&real.display().to_string()));
+    }
+
+    #[test]
+    fn chained_symlinks_resolve_to_the_final_directory() {
+        let tmp = TempDir::new();
+        let real = tmp.0.join("real");
+        fs::create_dir(&real).unwrap();
+        symlink(&real, tmp.0.join("first")).unwrap();
+        symlink(tmp.0.join("first"), tmp.0.join("second")).unwrap();
+
+        let root = resolve(&tmp.0.join("second")).unwrap();
+        assert_eq!(root.resolved, real);
+        assert!(root.symlinked);
+    }
+
+    #[test]
+    fn trailing_separator_still_detects_the_symlink() {
+        let tmp = TempDir::new();
+        let real = tmp.0.join("real");
+        let link = tmp.0.join("link");
+        fs::create_dir(&real).unwrap();
+        symlink(&real, &link).unwrap();
+
+        let with_slash = PathBuf::from(format!("{}/", link.display()));
+        let root = resolve(&with_slash).unwrap();
+        assert_eq!(root.resolved, real);
+        assert!(root.symlinked);
+    }
+
+    #[test]
+    fn dangling_symlink_names_the_missing_target() {
+        let tmp = TempDir::new();
+        let link = tmp.0.join("dangling");
+        symlink(tmp.0.join("gone"), &link).unwrap();
+
+        let error = resolve(&link).unwrap_err();
+        assert!(matches!(error, ProjectRootError::DanglingSymlink { .. }));
+        let text = error.to_string();
+        assert!(text.starts_with("cannot resolve "), "{text}");
+        assert!(text.contains(&tmp.0.join("gone").display().to_string()));
+    }
+
+    #[test]
+    fn symlink_cycle_is_a_structured_error() {
+        let tmp = TempDir::new();
+        let a = tmp.0.join("a");
+        let b = tmp.0.join("b");
+        symlink(&b, &a).unwrap();
+        symlink(&a, &b).unwrap();
+
+        let error = resolve(&a).unwrap_err();
+        assert!(matches!(error, ProjectRootError::SymlinkLoop { .. }));
+        assert!(error.to_string().starts_with("cannot resolve "));
+    }
+
+    #[test]
+    fn missing_path_keeps_the_original_message_shape() {
+        let tmp = TempDir::new();
+        let missing = tmp.0.join("nope");
+
+        let error = resolve(&missing).unwrap_err();
+        assert!(matches!(error, ProjectRootError::Io { .. }));
+        assert_eq!(
+            error.to_string(),
+            format!("cannot resolve {}", missing.display())
+        );
+        assert!(error.source().is_some());
+    }
+}
