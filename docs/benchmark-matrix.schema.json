{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ay-obami/soro-mutants/blob/main/docs/benchmark-matrix.schema.json",
  "title": "Soro Mutants benchmark matrix manifest v1",
  "type": "object",
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Major schema version. Readers must reject versions they do not support."
    },
    "description": {
      "type": "string",
      "description": "Optional human-readable description of this matrix."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable unique id; also used as the checkout directory name."
    },
    "revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "pattern": "^[0-9a-fA-F]+$",
      "description": "Pinned git commit. Short prefixes are recorded and resolved by the runner."
    },
    "target": {
      "type": "object",
      "required": ["id", "kind", "test_command"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["local", "external"] },
        "path": {
          "type": "string",
          "description": "Required for kind=local; must resolve inside the repository root."
        },
        "repository": {
          "type": "string",
          "pattern": "^https://",
          "description": "Required for kind=external; public https URL only."
        },
        "revision": { "$ref": "#/$defs/revision" },
        "operator": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3}$",
          "description": "Optional built-in operator filter."
        },
        "file": { "type": "string" },
        "function": { "type": "string" },
        "test_command": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
